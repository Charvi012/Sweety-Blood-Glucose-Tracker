NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-32-chars-or-more
JWT_EXPIRES_IN_HOURS=12
BCRYPT_COST=12
# Used to decide what "today" means for the "date cannot be in the future" rule
APP_TIMEZONE=Asia/Kolkata
CLIENT_ORIGIN=http://localhost:5173
